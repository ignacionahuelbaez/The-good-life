# Copiá este archivo a .env.local y completá los valores.
# .env.local no se versiona: la clave de servicio da acceso total a la base.

# Supabase → Project Settings → Data API
SUPABASE_URL="https://TU-PROYECTO.supabase.co"

# Supabase → Project Settings → API Keys → service_role
# Sólo se usa desde el servidor. Nunca la prefijes con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# Emails de confirmación de pedido (resend.com).
# Sin esto la tienda funciona igual: los emails no salen, pero quedan guardados
# como archivos en .emails/ para poder revisarlos.
RESEND_API_KEY=""

# Remitente. Para que no caiga en spam, el dominio tiene que estar verificado en
# Resend con SPF y DKIM. Mientras probás, dejalo vacío y se usa el remitente de
# prueba de Resend, que sólo puede escribirle a tu propia casilla.
EMAIL_FROM=""

# Contraseña del panel de pedidos, en /admin. Una sola, larga y única: no hay
# sistema de usuarios porque el panel lo usan una o dos personas del negocio.
# Cambiarla cierra todas las sesiones abiertas.
ADMIN_PASSWORD=""
